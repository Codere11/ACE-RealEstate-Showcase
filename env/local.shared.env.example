# Shared local env for both services.
# Copy to repo root as `.env`.
# Python loads root `.env` via app/core/env.py.
# Java loads root `.env` via spring.config.import in java-platform/application.yml.

# -----------------------------------------------------------------------------
# Shared secrets / AI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
ACE_LLM_PROVIDER=openai
ACE_LLM_MODEL=gpt-4.1-mini
ACE_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Local database
# Use one Postgres database for both services locally.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://ace_user:test_password_123@localhost:5433/ace_platform
ACE_DB_URL=jdbc:postgresql://localhost:5433/ace_platform
ACE_DB_USERNAME=ace_user
ACE_DB_PASSWORD=test_password_123

# Legacy Python fallback keys (keep aligned with DATABASE_URL only if needed)
ACE_DB_USER=ace_user
ACE_DB_PASS=test_password_123
ACE_DB_NAME=ace_platform
ACE_DB_HOST=localhost
ACE_DB_PORT=5433

# -----------------------------------------------------------------------------
# Cross-service wiring
# -----------------------------------------------------------------------------
ACE_PUBLIC_BASE_URL=http://127.0.0.1:8080
ace.python-backend-url=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
ACE_PAYMENT_PROVIDER=mock

# -----------------------------------------------------------------------------
# LiveKit Cloud
# -----------------------------------------------------------------------------
ACE_LIVEKIT_WS_URL=wss://your-project.livekit.cloud
ACE_LIVEKIT_API_KEY=your-livekit-api-key
ACE_LIVEKIT_API_SECRET=your-livekit-api-secret

# -----------------------------------------------------------------------------
# Java demo profile seed values
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
ace.demo.org-name=Demo Agency
ace.demo.org-slug=demo
ace.demo.admin-username=admin
ace.demo.admin-email=admin@ace.local
ace.demo.admin-password=change-this-demo-password
