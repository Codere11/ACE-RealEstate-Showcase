# Railway env for Java web service
# Paste into Railway Variables for the Java service.
# Use real concrete values. Do not leave placeholders.

SPRING_PROFILES_ACTIVE=demo
ACE_DB_URL=jdbc:postgresql://REAL_HOST:REAL_PORT/REAL_DATABASE
ACE_DB_USERNAME=REAL_USER
ACE_DB_PASSWORD=REAL_PASSWORD
ACE_SECRET=REPLACE_WITH_THE_SAME_SHARED_SECRET_AS_PYTHON
ACE_PUBLIC_BASE_URL=https://YOUR_PUBLIC_JAVA_DOMAIN
ace.python-backend-url=http://YOUR_RUNTIME_INTERNAL_URL
OPENAI_API_KEY=REPLACE_WITH_REAL_OPENAI_KEY
ACE_LLM_PROVIDER=openai
ACE_LLM_MODEL=gpt-4.1-mini
STRIPE_SECRET_KEY=REPLACE_WITH_REAL_STRIPE_SECRET
STRIPE_CONNECT_CLIENT_ID=REPLACE_WITH_REAL_STRIPE_CONNECT_CLIENT_ID
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_REAL_STRIPE_WEBHOOK_SECRET
ACE_LIVEKIT_WS_URL=wss://YOUR_PROJECT.livekit.cloud
ACE_LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
ACE_LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
ace.demo.org-name=Demo Agency
ace.demo.org-slug=demo
ace.demo.admin-username=admin
ace.demo.admin-email=admin@ace.local
ace.demo.admin-password=CHANGE_THIS_DEMO_PASSWORD
