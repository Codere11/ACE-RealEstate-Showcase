# Railway env for Python runtime service
# Paste into Railway Variables for the runtime service.
# Use real concrete values. Do not leave placeholders.

DATABASE_URL=postgresql://REAL_USER:REAL_PASSWORD@REAL_HOST:REAL_PORT/REAL_DATABASE
ACE_SECRET=REPLACE_WITH_THE_SAME_SHARED_SECRET_AS_JAVA
OPENAI_API_KEY=REPLACE_WITH_REAL_OPENAI_KEY
ACE_LLM_PROVIDER=openai
ACE_LLM_MODEL=gpt-4.1-mini
ACE_PUBLIC_BASE_URL=https://YOUR_PUBLIC_JAVA_DOMAIN
ACE_LIVEKIT_WS_URL=wss://YOUR_PROJECT.livekit.cloud
ACE_LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
ACE_LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
ACE_LOG_LEVEL=INFO
