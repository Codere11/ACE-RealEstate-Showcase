# Single-service Railway deployment
# One service, one database, one Dockerfile (repo root Dockerfile).
# The root Dockerfile now runs:
# - Java web app on the public PORT
# - Python runtime on 127.0.0.1:8000 inside the same container
# Python DATABASE_URL is auto-derived from ACE_DB_* if DATABASE_URL is not set.

SPRING_PROFILES_ACTIVE=demo
ACE_DB_URL=jdbc:postgresql://postgres.railway.internal:5432/ace_clean
ACE_DB_USERNAME=postgres
ACE_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
ACE_SECRET=REPLACE_WITH_SHARED_SECRET
ACE_PUBLIC_BASE_URL=https://YOUR_PUBLIC_DOMAIN.up.railway.app
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
ACE_LLM_PROVIDER=openai
ACE_LLM_MODEL=gpt-4.1-mini
ACE_LIVEKIT_WS_URL=wss://YOUR_PROJECT.livekit.cloud
ACE_LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
ACE_LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_CONNECT_CLIENT_ID=REPLACE_WITH_STRIPE_CONNECT_CLIENT_ID
# Optional until webhook is configured:
STRIPE_WEBHOOK_SECRET=
ACE_BOOTSTRAP_DB=0
ACE_PYTHON_BACKEND_URL=http://127.0.0.1:8000
ace.demo.org-name=Demo Agency
ace.demo.org-slug=demo
ace.demo.admin-username=admin
ace.demo.admin-email=admin@ace.local
ace.demo.admin-password=CHANGE_THIS_DEMO_PASSWORD
