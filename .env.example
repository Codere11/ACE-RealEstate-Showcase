# ACE e-Counter environment template
# Copy to .env and fill with real values.
# This file now reflects the current architecture:
# - Java Spring Boot app (`java-platform/`)
# - Python FastAPI + LangGraph runtime service (`app/`)

# -----------------------------------------------------------------------------
# Shared secrets / AI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
ACE_LLM_PROVIDER=openai
ACE_LLM_MODEL=gpt-4.1-mini
ACE_SECRET=replace-with-a-long-random-secret
ACE_LOG_LEVEL=INFO
ACE_ENFORCE_DUAL_CONTACT=1

# -----------------------------------------------------------------------------
# Java app database settings
# Used by java-platform/src/main/resources/application-*.yml
# Local default Java DB is usually ace_platform on port 5433.
# Railway / production should use managed Postgres values.
# -----------------------------------------------------------------------------
ACE_DB_URL=jdbc:postgresql://localhost:5433/ace_platform
ACE_DB_USERNAME=ace_user
ACE_DB_PASSWORD=test_password_123

# -----------------------------------------------------------------------------
# Python runtime database URL
# Used by the FastAPI runtime service.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://ace_user:test_password_123@localhost:5433/ace_platform

# -----------------------------------------------------------------------------
# Runtime wiring / public base URL
# ACE_PUBLIC_BASE_URL should be the public Java app URL.
# For local Java-first development, use http://127.0.0.1:8080
# For Railway/public deploy, use https://demo.yourdomain.com
# -----------------------------------------------------------------------------
ACE_PUBLIC_BASE_URL=http://127.0.0.1:8080
ACE_MANAGER_DASHBOARD_URL=http://127.0.0.1:8080
ACE_PAYMENT_PROVIDER=mock

# Internal URL from Java -> Python runtime
# Use the exact Spring property key below in .env so Java can import it directly.
ace.python-backend-url=http://127.0.0.1:8000
# Railway example:
# ace.python-backend-url=http://ace-runtime.railway.internal

# -----------------------------------------------------------------------------
# LiveKit Cloud
# Used by both Java and Python services.
# -----------------------------------------------------------------------------
ACE_LIVEKIT_WS_URL=wss://your-project.livekit.cloud
ACE_LIVEKIT_API_KEY=your-livekit-api-key
ACE_LIVEKIT_API_SECRET=your-livekit-api-secret

# -----------------------------------------------------------------------------
# Stripe
# Callback/webhook should point to the public Java app domain.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_CONNECT_CLIENT_ID=your-stripe-connect-client-id
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# -----------------------------------------------------------------------------
# Demo seed values for the Java app when SPRING_PROFILES_ACTIVE=demo
# Use the exact Spring property keys below in .env so Java can import them directly.
# These are useful for Railway/public demo deploys.
# -----------------------------------------------------------------------------
ace.demo.org-name=Demo Agency
ace.demo.org-slug=demo
ace.demo.admin-username=admin
ace.demo.admin-email=admin@ace.local
ace.demo.admin-password=change-this-demo-password

# Railway note:
# In Railway, the Java service should receive these keys directly:
#   SPRING_PROFILES_ACTIVE=demo
#   ACE_DB_URL=jdbc:postgresql://...
#   ACE_DB_USERNAME=...
#   ACE_DB_PASSWORD=...
#   ACE_PUBLIC_BASE_URL=https://demo.yourdomain.com
#   ace.python-backend-url=http://<internal-runtime-service>
#   ace.demo.org-name=...
#   ace.demo.org-slug=...
#   ace.demo.admin-username=...
#   ace.demo.admin-email=...
#   ace.demo.admin-password=...
# The Python runtime should receive:
#   DATABASE_URL=postgresql://...
#   ACE_PUBLIC_BASE_URL=https://demo.yourdomain.com
